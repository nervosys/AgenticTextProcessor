{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AQL",
  "scopeName": "source.aql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#conditions" },
    { "include": "#aggregations" },
    { "include": "#control-flow" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aql",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aql",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.aql",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.aql",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.aql",
          "begin": "/",
          "end": "/",
          "patterns": [
            {
              "name": "constant.character.escape.aql",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aql",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.aql",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.aql",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.comparison.aql",
          "match": "!=|>=|<=|>|<|="
        },
        {
          "name": "keyword.operator.comma.aql",
          "match": ","
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.stage.aql",
          "match": "\\b(find|replace|delete|insert|select|filter|sort|unique|take|skip|last|count|aggregate|set)\\b"
        },
        {
          "name": "keyword.other.clause.aql",
          "match": "\\b(with|before|after|between|and|or|not|by|as|in|from|to|separator|field|line|all|asc|desc)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.aql",
          "match": "\\b(ignore_case|literal|regex|whole_word|not_empty|contains|equals|matches|not_equals)\\b"
        }
      ]
    },
    "conditions": {
      "patterns": [
        {
          "name": "keyword.control.condition.aql",
          "match": "\\b(where|having)\\b"
        }
      ]
    },
    "aggregations": {
      "patterns": [
        {
          "name": "support.function.aggregate.aql",
          "match": "\\b(sum|avg|min|max|distinct|freq)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.flow.aql",
          "match": "\\b(let|if|then|else|end|group|groupby|group_by|def|define|fn|func|call|invoke)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.aql",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
