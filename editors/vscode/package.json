{
  "name": "atp-aql",
  "displayName": "ATP — AQL Language Support",
  "description": "Syntax highlighting and LSP support for AQL (ATP Query Language)",
  "version": "1.0.0",
  "publisher": "nervosys",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/nervosys/AgenticTextProcessor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:aql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aql",
        "aliases": ["AQL", "ATP Query Language"],
        "extensions": [".aql"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aql",
        "scopeName": "source.aql",
        "path": "./syntaxes/aql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ATP / AQL",
      "properties": {
        "atp.lspPath": {
          "type": "string",
          "default": "atp-lsp",
          "description": "Path to the atp-lsp binary"
        },
        "atp.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable the AQL Language Server"
        },
        "atp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication with the AQL language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
